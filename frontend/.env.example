# Frontend configuration. Copy to `.env.local` for local development.

# Backend URL reachable from the BROWSER (host machine).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL reachable from the Next.js SERVER. Only needed when it differs from the
# browser URL, e.g. inside Docker Compose (set automatically to http://backend:8000).
# API_INTERNAL_URL=http://backend:8000
