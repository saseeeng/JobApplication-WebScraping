# Backend configuration. Copy to `.env` for local development (never commit `.env`).
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite file. Defaults to <repo>/data/job_tracker.db when unset.
# Docker Compose sets this to sqlite:////data/job_tracker.db (mounted volume).
# DATABASE_URL=sqlite:///../data/job_tracker.db

# Create tables on startup.
AUTO_CREATE_TABLES=true

# Comma-separated browser origins allowed by CORS. Never use * in production.
CORS_ORIGINS=http://localhost:3000

# Scraper behaviour (HTTP scrapers: Kalibrr PH + OnlineJobs PH)
SCRAPER_TIMEOUT_SECONDS=10
SCRAPER_DELAY_SECONDS=10
SCRAPER_USER_AGENT=JobMarketTrackerBot/0.1 (+portfolio project; respects robots.txt)
